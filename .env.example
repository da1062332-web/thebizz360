# Copy to .env.local (or set in your hosting provider) before running `npm run build`.
# All values are read at build time and baked into the static files.

# Public URL where THIS marketing site is served. Used for canonical URLs,
# the sitemap, robots.txt, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.thebizz360.com

# Optional dedicated app entry points. Leave empty to send Food/Work CTAs
# to the production login (https://www.thebizz360.com/login).
NEXT_PUBLIC_FOOD_APP_URL=
NEXT_PUBLIC_WORK_APP_URL=

# --- Commercial complex enquiries ---
# 1) Form endpoint for the footer contact form and the /enquire/ page.
#    Defaults to https://formspree.io/f/xzzonkoy when left empty.
NEXT_PUBLIC_ENQUIRY_FORM_ACTION=
# Booking page for "Book a Call" buttons.
#    Defaults to https://cal.com/qloax-contact/discovery-call-30-min when left empty.
NEXT_PUBLIC_BOOKING_URL=
# 2) An external enquiry page (e.g. a booking or CRM form). Shown as a button.
NEXT_PUBLIC_ENQUIRY_URL=
# 3) A partnership email address. Shown as an email button and in the footer.
NEXT_PUBLIC_ENQUIRY_EMAIL=

# Set to "true" only when real Privacy Policy and Terms text has been added.
# Until then those pages are served with noindex.
NEXT_PUBLIC_LEGAL_PUBLISHED=false
